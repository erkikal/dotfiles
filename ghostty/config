macos-auto-secure-input = true

shell-integration = zsh
shell-integration-features = sudo,ssh-terminfo,ssh-env
notify-on-command-finish = unfocused

clipboard-read = allow
clipboard-write = allow
copy-on-select = true

theme = Catppuccin Mocha
background = #1E1E2E
foreground = #CDD6F4
selection-background = #585B70
selection-foreground = #CDD6F4
split-divider-color = #9CDF97
macos-titlebar-style = transparent

font-family = Terminess Nerd Font
font-size = 14

macos-option-as-alt = true
keybind = global:cmd+s=toggle_quick_terminal
keybind = alt+left=goto_split:left
keybind = alt+down=goto_split:down
keybind = alt+up=goto_split:up
keybind = alt+right=goto_split:right
keybind = alt+h=goto_split:previous
keybind = alt+j=goto_split:down
keybind = alt+k=goto_split:up
keybind = alt+l=goto_split:next
keybind = alt+two=text:@
keybind = alt+three=text:£
keybind = alt+four=text:$
keybind = alt+seven=text:{
keybind = alt+eight=text:[
keybind = alt+nine=text:]
keybind = alt+zero=text:}
keybind = alt+ä=text:^
keybind = alt+plus=text:\\
keybind = alt+<=text:|

quick-terminal-animation-duration = 0
